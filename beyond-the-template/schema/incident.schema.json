{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","name","period","began","category","status","summary","steps","risk","control_summary","auditor_questions","sources","changelog"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$","description":"Matches the file name. Used as the page link."},
    "name": {"type":"string"},
    "period": {"type":"string","description":"When it happened, in words. Example: Oct to Nov 2026"},
    "began": {"type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$","description":"Year and month the incident began, YYYY-MM. Sets the order of the feed, newest first."},
    "category": {"type":"string","description":"One value from taxonomy/categories.json"},
    "status": {"enum":["candidate","accepted","drafted","in-review","published","watching","closed"]},
    "summary": {"type":"string","maxLength":400},
    "steps": {"type":"array","minItems":3,"items":{
      "type":"object","additionalProperties":false,
      "required":["event","criteria","failure_mode","rationale","template_control","custom_control"],
      "properties":{
        "event":{"type":"string","description":"What happened, from a cited source. No inference."},
        "criteria":{"type":"array","minItems":1,"items":{"type":"string"},"description":"Codes from taxonomy/tsc.json"},
        "failure_mode":{"type":"string","description":"Key from taxonomy/failure-modes.json"},
        "rationale":{"type":"string","description":"Why this failure mode. Inference is allowed here and only here."},
        "template_control":{"type":"string","description":"Generic wording a templated report would carry."},
        "custom_control":{"type":"string","description":"Control written for this environment. Written by the mapper."},
        "test":{"type":"string","description":"Optional. How an auditor would test the custom control."}
      }}},
    "risk": {"type":"string","description":"Summary: the risk this environment carried, in a short paragraph drawn from the steps."},
    "control_summary": {"type":"string","description":"Summary: how the custom controls in the steps would have helped in this scenario."},
    "auditor_questions": {"type":"array","minItems":1,"items":{"type":"string"}},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["label","url"],"properties":{"label":{"type":"string"},"url":{"type":"string","pattern":"^https://"},"primary":{"type":"boolean"}}}},
    "changelog": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["date","note"],"properties":{"date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"note":{"type":"string"}}}},
    "mapper": {"type":"string"},
    "reviewer": {"type":"string"}
  }
}
